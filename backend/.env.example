# ============================================================
#  REQUIRED — the app will not work without these
# ============================================================

# --- Firebase (Project settings → Service accounts → Generate key) ---
# EASIEST: paste the whole downloaded JSON file as one value, { to }.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","...":"..."}

# Or, if you'd rather split it up, use these three instead and leave the above blank:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n

# --- The upstream API you are reselling ---
REAL_API_BASE_URL_1=https://your-api.vercel.app

# --- Admin panel password (pick a long random one) ---
ADMIN_SECRET=change_this_to_a_long_random_secret

# --- Your own public URL, set after the first deploy ---
BACKEND_URL=https://your-app.onrender.com


# ============================================================
#  PAYMENTS — required only if you are selling plans
# ============================================================
HELEKET_MERCHANT=your_merchant_uuid
HELEKET_API_KEY=your_heleket_api_key
HELEKET_BASE_URL=https://api.heleket.com


# ============================================================
#  KEY-DELIVERY EMAIL — optional. Without these, keys still get
#  issued and shown on the payment page; only the email is skipped.
# ============================================================

# Brevo (brevo.com) — free tier sends 300 emails/day. Create an account,
# verify your domain there, then Settings -> SMTP & API -> "API Keys" tab
# (NOT the "SMTP" tab) -> Generate a new API key.
# Starts with xkeysib-... . The xsmtpsib-... key on the SMTP tab is a
# different credential for port-587 relay, which Vercel blocks outbound
# anyway — this app sends over Brevo's HTTPS API instead, so that key is
# the wrong one here even if you already generated it.
BREVO_API_KEY=

# Must be an address on a domain you verified in Brevo, e.g. api@yourdomain.com.
# It does not need a real inbox to SEND from — see SETUP.md.
MAIL_FROM=api@yourdomain.com
MAIL_FROM_NAME=NexAPI

# Telegram link put in the email footer. Same handle as the site — see
# TELEGRAM in frontend/config.js.
SUPPORT_TELEGRAM_URL=https://t.me/WhiteHatCeo


# ============================================================
#  OPTIONAL — sensible defaults, set only what you need
# ============================================================

# Upstream path. Default: /admin/paid/key
REAL_API_PATH_1=/admin/paid/key

# Upstream key. Leave unset if your API is open and needs no key.
REAL_API_KEY_1=

# Query param the upstream wants its key in (key / apikey / token). Default: key
REAL_API_KEY_PARAM_1=key

# GET (default) or POST. Use POST when the upstream expects a JSON body.
REAL_API_METHOD_1=GET

# POST only. JSON template for the body; {placeholders} are filled from the
# caller's query params. Leave blank to forward the params unchanged.
#   Upstream wants {"phone": "..."} and the caller sends ?num=… :
#     REAL_API_BODY_1={"phone":"{num}"}
#   Fixed body with no caller input:
#     REAL_API_BODY_1={"level":5}
REAL_API_BODY_1=

# --- Second upstream, for api2 or 'both' plans ---
REAL_API_BASE_URL_2=https://your-api-2.vercel.app
REAL_API_PATH_2=/admin/paid/key
REAL_API_KEY_2=
REAL_API_KEY_PARAM_2=key
REAL_API_METHOD_2=GET
REAL_API_BODY_2=

# 'both' plans call the two upstreams at the same time by default. Set this when
# the order matters — one upstream has to prime state before the other acts on
# it. API 1 then runs to completion before API 2 starts.
UPSTREAM_SEQUENTIAL=false

# Which upstream(s) seeded plans use: api1 | api2 | both
#   both = call BOTH APIs in parallel and merge their responses into one
DEFAULT_API_TARGET=api1

# Give up on the upstream after this many ms and return 504
UPSTREAM_TIMEOUT_MS=30000

# Keeps Render's free tier from sleeping. Set it to your own URL.
RENDER_URL=https://your-app.onrender.com

# How often to re-check pending orders against Heleket, in minutes.
# This is the safety net for a webhook that never arrived. Default 2.
SYNC_INTERVAL_MIN=2

# Only needed if the frontend is hosted somewhere else (e.g. Vercel).
# Leave both unset when this server serves the frontend — they are derived
# from BACKEND_URL automatically.
FRONTEND_URL=
HELEKET_RETURN=

PORT=3000
