# ============================================
# FIREBASE (Settings → Service Accounts → Generate Key)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full private key including -----BEGIN/END----- with literal \n
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ============================================
# REAL API (Your actual upstream API)
# REAL_API_PATH_x is optional — defaults to /admin/paid/key.
# Set it if your upstream uses a different path, e.g. /api/v1/lookup
# ============================================
REAL_API_KEY_1=your_real_api_key_here
REAL_API_BASE_URL_1=https://real-api-1.example.com
REAL_API_PATH_1=/admin/paid/key

REAL_API_KEY_2=your_second_real_api_key
REAL_API_BASE_URL_2=https://real-api-2.example.com
REAL_API_PATH_2=/admin/paid/key

# How long to wait on the upstream before returning 504 (ms)
UPSTREAM_TIMEOUT_MS=30000

# ============================================
# HELEKET PAYMENT
# ============================================
HELEKET_MERCHANT=your_merchant_uuid
HELEKET_API_KEY=your_heleket_api_key
HELEKET_BASE_URL=https://api.heleket.com

# ============================================
# APP URLS
# ============================================
PORT=3000
BACKEND_URL=https://your-app.onrender.com
FRONTEND_URL=https://your-site.vercel.app
HELEKET_RETURN=https://your-site.vercel.app/pay.html

# ============================================
# ADMIN (Choose a strong password)
# ============================================
ADMIN_SECRET=change_this_to_a_strong_secret_password

# ============================================
# RENDER AUTO-PING (keeps free tier awake)
# Paste your Render URL here after deploying
# ============================================
RENDER_URL=https://your-app.onrender.com
